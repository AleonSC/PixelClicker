<Project>
  <!-- Shared settings for the compile check (not part of the Unity project). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity 2021.3 - Unity 6 compile C# 9. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS1701;CS1702;CS0649;CS0414;CS0169;NU1701</NoWarn>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory).build/bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="AddUnityReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <UnityModule Include="$(PkgUnityEngine_Modules)/lib/netstandard2.0/UnityEngine.*Module.dll" />
      <Reference Include="@(UnityModule)" Private="false" />
    </ItemGroup>
  </Target>
</Project>
